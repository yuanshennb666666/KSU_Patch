# Build output
/target
/dist/

# Patch output written by the tool when no -o is given
/out

# Firmware inputs and patched images: large, and never part of the source
*.apk
*.img

# Python bytecode
__pycache__/
*.pyc

# Editor / agent scratch state (the tool that touches this repo keeps its own
# bookkeeping here; it must never be published)
.mimocode/

# Local investigation scratch (upstream sources, downloaded APKs, experiments)
/.work/
